// app.rc
1 ICON "krayacc.ico"

#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0" // 0x0409 (en-US), 1200 (Unicode)
    BEGIN
      VALUE "CompanyName",      "AinhoSoft SPA\0"
      VALUE "FileDescription",  "KrayAcc - Client\0"
      VALUE "FileVersion",      "1.0.0.0\0"
      VALUE "InternalName",     "KrayAcc\0"
      VALUE "OriginalFilename", "KrayAcc.exe\0"
      VALUE "ProductName",      "KrayAcc\0"
      VALUE "ProductVersion",   "1.0.0.0\0"
      VALUE "LegalCopyright",   "© 2025 AinhoSoft SPA\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
